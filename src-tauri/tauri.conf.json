{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DnD Battlemap",
  "version": "0.1.0",
  "identifier": "de.dndbattlemap.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "DnD Battlemap",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "freezePrototype": true,
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "media-src": "'self' asset: http://asset.localhost blob:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost blob: data:",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "media-src": "'self' asset: http://asset.localhost blob:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost blob: data: ws://localhost:1420",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "RolePlayingGame",
    "shortDescription": "Offline-Battlemap für D&D 5e",
    "longDescription": "Interaktive Kampfkarten für D&D 5e (SRD 5.1): Karteneditor, Bildimport mit Rasterkalibrierung, Tokens, Effektbereiche, Initiative – komplett offline.",
    "copyright": "Regelinhalte: SRD 5.1 von Wizards of the Coast LLC, CC-BY-4.0",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "languages": ["German", "English"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      },
      "wix": {
        "language": ["de-DE", "en-US"]
      }
    },
    "linux": {
      "deb": { "depends": [] }
    }
  }
}
